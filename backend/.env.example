# Copy this file to ".env" and fill in your own values.
# .env is listed in .gitignore, so your password never goes to GitHub.

# ----- Option A: MongoDB Atlas (cloud) -----
# In Atlas: Database -> Connect -> Drivers -> copy the connection string.
# Replace <username> and <password> with your Atlas database user.
# If the password has special characters (@ : / ? #), change them to
# %40 %3A %2F %3F %23, or pick a password with only letters and numbers.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# ----- Option B: MongoDB installed on your own computer -----
# Delete the Atlas line above and use this one instead:
# MONGODB_URI=mongodb://localhost:27017

# The database name inside MongoDB (created automatically by seed.py).
# The database name. Keep "Moodbite" so you keep your existing data.
MONGO_DB_NAME=Moodbite

# The React app's address (allowed by CORS)
FRONTEND_URL=http://localhost:5173

# Port for the Flask server. If 5000 is already in use, use 5001 here
# AND set VITE_API_URL=http://localhost:5001/api in frontend/.env.
PORT=5000

# ----- Stage 4: login -----
# Long random secrets used to sign logins. Make your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Run it twice and paste one result into each line below.
SECRET_KEY=paste_a_long_random_value_here
JWT_SECRET_KEY=paste_a_different_long_random_value_here

# How many days a login lasts before you need to log in again.
JWT_EXPIRES_DAYS=7

# ----- Stage 5: real restaurants (Google Places API) -----
# A Google Cloud API key with "Places API (New)" enabled. This is the
# SERVER key: only Flask uses it. Leave it empty to use sample restaurants.
GOOGLE_PLACES_API_KEY=
# Search radius around the user, in metres.
PLACES_SEARCH_RADIUS_M=5000

# ----- Stage 6: smart recommendations -----
# Budget levels for dollar amounts in messages ($15 or less = "$", etc.)
BUDGET_CHEAP_MAX=15
BUDGET_MODERATE_MAX=30
# OPTIONAL: an Anthropic (Claude) API key to understand messages with AI.
# Leave empty to use the free keyword parser only. Never commit a real key.
AI_API_KEY=
AI_MODEL=claude-haiku-5-5

# Optional: password for the demo account made by "python seed.py --demo".
# Use a new password you don't use anywhere else.
DEMO_PASSWORD=
