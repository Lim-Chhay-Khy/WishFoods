# Copy this file to ".env" for local development.
# Vite only shows variables starting with VITE_ to the React code, and
# EVERYTHING here ends up in the browser, so never put secrets here.

# Address of the Flask backend ("/api" is added automatically).
#   local:      http://localhost:5000
#   production: https://<your-backend>.onrender.com  (set in your host's settings)
VITE_API_URL=http://localhost:5000

# Google map (a BROWSER key with "Maps JavaScript API" enabled).
# Restrict it in Google Cloud to your site addresses, e.g.
# http://localhost:5173/* and https://<your-site>.vercel.app/*
# Leave empty = no map (restaurants still show as cards).
VITE_GOOGLE_MAPS_API_KEY=
# Optional: your own Map ID from Google Cloud. Empty = Google's DEMO_MAP_ID.
VITE_GOOGLE_MAP_ID=
